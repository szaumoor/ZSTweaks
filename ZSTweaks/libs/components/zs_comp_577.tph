ACTION_IF is_iwdee BEGIN OUTER_SET the_cap = 30 END ELSE BEGIN OUTER_SET the_cap=20 END

DEFINE_PATCH_MACRO nerf_haste BEGIN
    LPF ~CD_TRIM-O-MATIC~ INT_VAR level_cap = 1 END
    LPF ALTER_EFFECT_EX INT_VAR duration = start_duration STR_VAR match_duration_ex = "(o_duration > 5)" END
    LPF ~CD_EXTEND-O-MATIC~ INT_VAR dur_special=1 step_dur=6 step_size=level_jump level_cap=the_cap END
END

DEFINE_PATCH_MACRO ~nerf_haste#normal~ BEGIN
    SET start_duration = 6
    SET level_jump = 3
    LPM nerf_haste
END

DEFINE_PATCH_MACRO ~nerf_haste#improved~ BEGIN
    SET start_duration = 6
    SET level_jump = 4
    LPM nerf_haste
END

COPY_EXISTING ~spin828.spl~ ~override~ // mazzy
    LPF ALTER_SPELL INT_VAR desc = RESOLVE_STR_REF(@77020) END
    LPM ~nerf_haste#normal~
IF_EXISTS

COPY_EXISTING ~spra301.spl~ ~override~ // kit_stalker
    LPF ALTER_SPELL INT_VAR desc = RESOLVE_STR_REF(@77000) END
    LPM ~nerf_haste#normal~

COPY_EXISTING ~spwi305.spl~ ~override~ // wizard
    LPF ALTER_SPELL INT_VAR desc = RESOLVE_STR_REF(@77000) END
    LPM ~nerf_haste#normal~

COPY_EXISTING ~spwi613.spl~ ~override~ // wizard improved haste
    LPF ALTER_SPELL INT_VAR desc = RESOLVE_STR_REF(@77010) END
    LPM ~nerf_haste#improved~

COPY_EXISTING ~spwish36.spl~ ~override~ // improved haste wish
              ~spwish37.spl~ ~override~
    LPF ALTER_EFFECT_EX INT_VAR duration = 30 STR_VAR match_duration_ex = "(o_duration > 5)" END
BUT_ONLY IF_EXISTS
