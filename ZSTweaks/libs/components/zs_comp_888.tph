              ~spwi310.spl~ ~override~ // non detection
              ~spwi311.spl~ ~override~ // prot vs normal missiles
              ~spwi317.spl~ ~override~ // ghost armor, preset target on IWDEE
              ~spwi319.spl~ ~override~ // prot vs fire
              ~spwi320.spl~ ~override~ // prot vs cold
              ~spwi405.spl~ ~override~ // improv invisibility
              ~spwi410.spl~ ~override~ // remove curse
