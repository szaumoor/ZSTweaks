              ~spcl211.spl~ ~override~ // paladin lay on hands

              ~spcl101.spl~ ~override~ // bhaalspawn cure light wounds
              ~spcl102.spl~ ~override~ // bhalspawn slow poison

              ~splc815.spl~ ~override~ // monk lay on hands (self only, patched in case other mod changes that)
              ~splc827.spl~ ~override~ // mazzy lay on hands (self only, patched in case other mod changes that)

              ~rr#pr212.spl~ ~override~ // dynaheir slow poison created by aTweaks' Revised Bhaalspawn Powers

              ~spdr401.spl~ ~override~ // improved invisibility avenger

              ~ohtyr1.spl~ ~override~ // exaltation priest of tyr

    LPM apply
BUT_ONLY IF_EXISTS

ACTION_IF spell_protect_from_good > 0 BEGIN

    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = "CLERIC_PROTECT_FROM_GOOD" RET spell_res END
        COPY_EXISTING ~%spell_res%.spl~ ~override~
            LPM apply

END

