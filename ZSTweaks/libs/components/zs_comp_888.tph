DEFINE_PATCH_MACRO apply BEGIN
    WRITE_LONG 0x8 (THIS BOR (1 << BIT24))
    LPF ALTER_EFFECT INT_VAR check_globals = 0 power=0 END
END

ACTION_IF zst_888_include_healing_spells BEGIN

    COPY_EXISTING ~sppr103.spl~  ~override~
                  ~sppr315.spl~  ~override~
                  ~sppr401.spl~  ~override~
                  ~sppr502.spl~  ~override~
                  ~bdcaela3.spl~ ~override~
                  ~sppr607.spl~  ~override~
        LPM apply
    BUT_ONLY IF_EXISTS

    ACTION_IF spell_cure_moderate_wounds > 0 BEGIN

        LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = "CLERIC_CURE_MODERATE_WOUNDS" RET spell_res END
        COPY_EXISTING ~%spell_res%.spl~ ~override~
            LPM apply
    END

END

