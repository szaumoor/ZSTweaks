ACTION_IF NOT is_iwdee BEGIN

  ACTION_IF FILE_EXISTS_IN_GAME ~bdring10.itm~ BEGIN

    DEFINE_PATCH_MACRO patch_file BEGIN LPF ALTER_EFF_FILE INT_VAR opcode = 89 parameter1 = 1 parameter2 = 1 END END
    LAF CREATE_EQ_EFF STR_VAR filename = ~zstwpur0~ RET file_ext END // priest slots level 1
    COPY_EXISTING ~%file_ext%~ ~override/zstwpur1.eff~ // priest slots level 2
      LPF ALTER_EFF_FILE INT_VAR parameter2 = 2 END

    COPY_EXISTING ~bdring10.itm~ ~override~
      LPF ALTER_ITEM INT_VAR id_desc = RESOLVE_STR_REF(@7820) END
      LPF CLONE_EFFECT INT_VAR match_opcode=219 opcode = 178 special = 1 END
      LPF CLONE_EFFECT INT_VAR match_opcode = 178 opcode = 179 END
      LPF ADD_EQUIPPED_EFF INT_VAR p1=alignmen_mask_good p2=8 STR_VAR effects = ~op=177,res=zstwpur0;op=177,res=zstwpur1~ END

  END ELSE BEGIN
    LAF LOG_TEXT INT_VAR predicate_stdout = (NOT group_component) STR_VAR log_level="abort" message = "Ring of Purity not found. -- Harmless unless it's BGEE with SoD or EET." END
  END

END
