OUTER_SET fade_speed_holy = (25 << 16)
ADD_PROJECTILE ~%MOD_FOLDER%/pro/ZSTWRDPJ.pro~
COPY ~%MOD_FOLDER%/spells/divine/divine_words~ ~override~
COPY_EXISTING ~sppr710.spl~ ~override~
  LPF ALTER_SPELL INT_VAR desc=RESOLVE_STR_REF(@8650) END
  LPF ALTER_HEADER INT_VAR projectile = %ZSTWRDPJ% END
  LPF DELETE_EFFECT_EX STR_VAR match_opcode_ex = "(o_opcode != 215)" END
  LPF RGB INT_VAR red = 128 green = 128 blue = 128 RET color = result END
  LPF ADD_SPL_TGTEFF INT_VAR rd=2 tmg=0 pwr=7 STR_VAR effects = ~op=326,p2=104,p1=%race_demilich%,res=zstwrd07;op=318,p2=104,p1=%race_demilich%,res=%SOURCE_RES%;op=326,p2=107,p1=6,res=zstwrd04;op=318,p2=66,res=%SOURCE_RES%;op=177,p2=3,p1=%general_undead%,res=zstwrd05;op=318,p2=1,res=%SOURCE_RES%;op=177,p2=8,p1=%alignmen_mask_evil%,res=zstwrd05;op=177,p2=8,p1=%alignmen_mask_neutral%,res=zstwrd05~ END

ACTION_IF has_eefixpack BEGIN

  COPY_EXISTING ~zstwrd00.spl~ ~override~
    LPF CLONE_EFFECT
        INT_VAR
          match_opcode = 13
          opcode = 318
          parameter1 = splstate_fp_death_immunity
          timing = 0
          parameter2 = 115
        STR_VAR
          insert = "above"
    END

END


COPY_EXISTING ~sppr715.spl~ ~override~
  LPF ALTER_SPELL INT_VAR desc=RESOLVE_STR_REF(@8651) END
  LPF ALTER_HEADER INT_VAR projectile = %ZSTWRDPJ% END
  LPF DELETE_EFFECT_EX STR_VAR match_opcode_ex = "(o_opcode != 215)" END
  LPF ADD_SPL_TGTEFF INT_VAR rd=2 tmg=0 pwr=7 STR_VAR effects = ~op=326,p2=107,p1=6,res=zstwrd04;op=318,p2=66,res=%SOURCE_RES%;op=177,p2=8,p1=%alignmen_mask_good%,res=zstwrd05;op=177,p2=8,p1=%alignmen_mask_neutral%,res=zstwrd05~ END
