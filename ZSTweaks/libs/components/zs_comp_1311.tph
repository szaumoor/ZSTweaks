ACTION_IF NOT is_iwdee BEGIN

  DEFINE_PATCH_MACRO patch_file BEGIN LPF ALTER_EFF_FILE INT_VAR opcode = 12 parameter1 = 2 END END
  LAF CREATE_TG_EFF STR_VAR filename = "zstwbl01" END // humanoid attack

  COPY_EXISTING ~blun11.itm~ ~override~
    LPF ALTER_ITEM INT_VAR id_desc=RESOLVE_STR_REF(@6150) END
    LPF ADD_ON_HIT_EFF STR_VAR effects = ~op=177,p1=1,p2=3,tmg=1,rd=2,res=zstwbl01~ END

END
