COPY_EXISTING ~spcl731.spl~ ~override~
    LPF ALTER_SPELL INT_VAR desc = RESOLVE_STR_REF(@9000) END
    WRITE_LONG 0x54 "-1" // nonsense strref
    LPF ~CD_TRIM-O-MATIC~ INT_VAR level_cap = 1 END
    LPF ALTER_EFFECT_EX INT_VAR duration = 18 STR_VAR match_duration_ex = "(o_duration >= 6)" END
    LPF ALTER_HEADER INT_VAR speed = 3 END
    LPF ~CD_EXTEND-O-MATIC~ INT_VAR dur_special=1 step_dur=6 level_cap=40 END

    FOR ( h = 4; h <= 40; ++h ) BEGIN

        SET fourth_diff = h - (h MODULO 4)
        PATCH_IF h < 10 BEGIN SPRINT h_str "0%fourth_diff%"
        END ELSE BEGIN SPRINT h_str "%fourth_diff%" END

        LPF ALTER_EFFECT INT_VAR header = h - 1 match_opcode = 111 STR_VAR resource = "zstsek%h_str%" END

    END
