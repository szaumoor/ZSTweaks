COPY_EXISTING ~sw1hseek.itm~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 145 END

COPY_EXISTING ~sw1hseek.itm~ ~override~
    LPF ALTER_HEADER INT_VAR to_hit = 1 dicesize = 4 dicenumber = 2 damage=0 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 1 parameter1 = 2 END

COPY_EXISTING ~sw1hseek.itm~ ~override/zstsek04.itm~
    LPF ALTER_HEADER INT_VAR to_hit=1 dicesize = 4 dicenumber = 2 damage=1 END

