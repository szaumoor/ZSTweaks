              ~bazliz03.cre~ ~override~ // lizardmen, often neutral, even in this game, evil here for some reason
              ~bazliz04.cre~ ~override~ // lizardmen, often neutral, even in this game, evil here for some reason
              ~clgol01.cre~  ~override~ // clay golem in planar sphere is chaotic good somehow?
              ~senstalk.cre~ ~override~ // invisible stalker, they're neutral elemental creatures
              ~gorstalk.cre~ ~override~ // invisible stalker, they're neutral elemental creatures
              ~stalke.cre~   ~override~ // invisible stalker, they're neutral elemental creatures
              ~spidswsu.cre~ ~override~ // sword spider is neutral
              ~spidsw01.cre~ ~override~ // sword spider is neutral
              ~spspid07.cre~ ~override~ // sword spider is neutral
              ~plyspid.cre~  ~override~  // sword spider is neutral
              ~udspid01.cre~ ~override~ // spider
              ~udspid02.cre~ ~override~ // spider
              ~udspid03.cre~ ~override~ // spider
              ~udspid04.cre~ ~override~ // spider
              ~udspid05.cre~ ~override~ // spider
              ~udspid06.cre~ ~override~ // spider
              ~udspid07.cre~ ~override~ // spider
              ~udspid08.cre~ ~override~ // spider
              ~ohbspi01.cre~ ~override~ // spider
              ~ohhspid1.cre~ ~override~  // hexxat quest spider is neutral
              ~ohhspid2.cre~ ~override~  // hexxat quest spider is neutral
              ~ohhspi01.cre~ ~override~  // hexxat quest spider is neutral
              ~ohhspi02.cre~ ~override~  // hexxat quest spider is neutral
              ~ohhspi03.cre~ ~override~  // hexxat quest spider is neutral
              ~wyvern01.cre~ ~override~ // wyverns should be true neutral in my estimation, currently locked as neutral EDIT_SAV_FILE
              ~wyvernsu.cre~ ~override~
