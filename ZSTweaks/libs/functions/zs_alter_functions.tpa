/*
    Modify the basic values of any item, to ease use without having to memorize offsets or remember the size in bytes of anything (which I HATE!).

    All integer variables except variables to refer to string references default to -1. String references default to -2, since -1 is a value one might want to have for string references to
    mean no reference.
*/
DEFINE_PATCH_FUNCTION ALTER_ITEM
INT_VAR
    //// Use these for known string references, or pass a new string using RESOLVE_STR_REF(<string>)
    general_name  = "-2"
    id_name       = "-2"
    general_desc  = "-2"
    id_desc       = "-2"
    ////////////////////////////////////////////////////////////////////////////////////////////////
    flags         = "-1"
    flags_plus    = 0
    flags_add_bit = "-1"
    flags_del_bit = "-1"
    //////////
    category      = "-1"
    wpn_prof      = "-1"
    //////////
    min_level     = "-1"
    min_str       = "-1"
    min_str_bonus = "-1"
    min_dex       = "-1"
    min_con       = "-1"
    min_int       = "-1"
    min_wis       = "-1"
    min_cha       = "-1"
    //////////
    unusable0     = "-1"
    unusable1     = "-1"
    unusable2     = "-1"
    unusable3     = "-1"
    unusable4     = "-1"
    //////////
    price         = "-1"
    max_stack     = "-1"
    lore          = "-1"
    weight        = "-1"
    ench          = "-1"
STR_VAR
    used_up_itm = ~none~
    appearance  = ~none~
    icon        = ~none~
    ground_icon = ~none~
    desc_img    = ~none~
BEGIN
    PATCH_IF zs_debug BEGIN
        LPF CHECK_EXTENSION STR_VAR extension = "ITM" END
    END

    PATCH_IF general_name > "-2" BEGIN
        WRITE_LONG 0x08 general_name
    END ELSE PATCH_IF general_name < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to general_name"
    END

    PATCH_IF general_desc > "-2" BEGIN
        WRITE_LONG 0x50 general_desc
    END ELSE PATCH_IF general_desc < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to general_desc"
    END

    PATCH_IF id_name > "-2" BEGIN
        WRITE_LONG 0x0c id_name
    END ELSE PATCH_IF id_name < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to id_name"
    END

    PATCH_IF id_desc > "-2" BEGIN
        WRITE_LONG 0x54 id_desc
    END ELSE PATCH_IF id_desc < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to id_desc"
    END

    PATCH_IF flags > "-1" BEGIN
        WRITE_LONG 0x18 flags
    END ELSE PATCH_IF flags < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to flags"
    END

    PATCH_IF flags_plus > 0 BEGIN
        WRITE_LONG 0x18 (THIS + flag_plus)
    END

    PATCH_IF flags_add_bit >= 0 AND flags_add_bit < 32 BEGIN

        LPF IS_BIT_SET INT_VAR bit_field = LONG_AT(0x18) bit=flags_add_bit RET set = result END

        PATCH_IF NOT set BEGIN
            WRITE_LONG 0x18 (THIS + 2**flags_add_bit)
        END

        ELSE BEGIN
            PATCH_IF zs_debug BEGIN
                PATCH_WARN "[WARN]: Flag was not set, thus ALTER_ITEM didn't make any changes"
            END
        END

    END ELSE PATCH_IF flags_add_bit != "-1" BEGIN

        PATCH_FAIL "[FAIL]: Passed an invalid bit to add to the 32 bit field of flags: %flags_add_bit%"

    END

    PATCH_IF flags_del_bit >= 0 AND flags_del_bit < 32 BEGIN

        LPF IS_BIT_SET INT_VAR bit_field = LONG_AT(0x18) bit=flags_del_bit RET set = result END

        PATCH_IF set BEGIN
            WRITE_LONG 0x18 (THIS - 2**flags_del_bit)
        END

        ELSE BEGIN
            PATCH_IF zs_debug BEGIN
                PATCH_WARN "[WARN]: Flag was not unset, thus ALTER_ITEM didn't make any changes"
            END
        END

    END ELSE PATCH_IF flags_add_bit != "-1" BEGIN

        PATCH_FAIL "[FAIL]: Passed an invalid bit to delete to the 32 bit field of flags: %flags_add_bit%"

    END

    PATCH_IF category > "-1" BEGIN
        WRITE_BYTE 0x1c category
    END ELSE PATCH_IF category < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to category"
    END

    PATCH_IF wpn_prof > "-1" BEGIN
        WRITE_LONG 0x31 wpn_prof
    END ELSE PATCH_IF wpn_prof < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to wpn_prof"
    END

    PATCH_IF min_level > "-1" BEGIN
        WRITE_SHORT 0x24 min_level
    END ELSE PATCH_IF min_level < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_level"
    END

    PATCH_IF min_str > "-1" BEGIN
        WRITE_SHORT 0x26 min_str
    END ELSE PATCH_IF min_str < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_level"
    END

    PATCH_IF min_str_bonus > "-1" BEGIN
        WRITE_BYTE 0x28 min_str_bonus
    END ELSE PATCH_IF min_str_bonus < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_str_bonus"
    END

    PATCH_IF min_int > "-1" BEGIN
        WRITE_BYTE 0x2a min_int
    END ELSE PATCH_IF min_int < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_int"
    END

    PATCH_IF min_dex > "-1" BEGIN
        WRITE_BYTE 0x2c min_dex
    END ELSE PATCH_IF min_dex < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_dex"
    END

    PATCH_IF min_wis > "-1" BEGIN
        WRITE_BYTE 0x2e min_wis
    END ELSE PATCH_IF min_wis < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_wis"
    END

    PATCH_IF min_con > "-1" BEGIN
        WRITE_BYTE 0x30 min_con
    END ELSE PATCH_IF min_con < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_con"
    END

    PATCH_IF min_cha > "-1" BEGIN
        WRITE_SHORT 0x30 min_cha
    END ELSE PATCH_IF min_cha < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to min_cha"
    END

    PATCH_IF max_stack > "-1" BEGIN
        WRITE_SHORT 0x38 max_stack
    END ELSE PATCH_IF max_stack < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to max_stack"
    END

    PATCH_IF lore > "-1" BEGIN
        WRITE_SHORT 0x42 lore
    END ELSE PATCH_IF lore < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to lore"
    END

    PATCH_IF weight > "-1" BEGIN
        WRITE_LONG 0x4c weight
    END ELSE PATCH_IF weight < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to weight"
    END

    PATCH_IF ench > "-1" BEGIN
        WRITE_LONG 0x60 ench
    END ELSE PATCH_IF ench < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to ench"
    END

    PATCH_IF unusable0 > "-1" BEGIN
        WRITE_LONG 0x1e unusable0
    END ELSE PATCH_IF unusable0 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to unusable0"
    END

    PATCH_IF unusable1 > "-1" BEGIN
        WRITE_BYTE 0x29 unusable1
    END ELSE PATCH_IF unusable1 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to unusable1"
    END

    PATCH_IF unusable2 > "-1" BEGIN
        WRITE_BYTE 0x2b unusable2
    END ELSE PATCH_IF unusable2 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to unusable2"
    END

    PATCH_IF unusable3 > "-1" BEGIN
        WRITE_BYTE 0x2d unusable3
    END ELSE PATCH_IF unusable3 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to unusable3"
    END

    PATCH_IF unusable4 > "-1" BEGIN
        WRITE_BYTE 0x2f unusable4
    END ELSE PATCH_IF unusable4 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to unusable4"
    END

    PATCH_IF price > "-1" BEGIN
        WRITE_LONG 0x34 price
    END ELSE PATCH_IF price < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to price"
    END

    PATCH_IF NOT "%used_up_itm%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x10 "%used_up_itm%" #8
    END

    PATCH_IF NOT "%icon%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x3a "%icon%" #8
    END

    PATCH_IF NOT "%ground_icon%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x44 "%ground_icon%" #8
    END

    PATCH_IF NOT "%desc_img%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x58 "%desc_img%" #8
    END

    PATCH_IF NOT "%appearance%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x22 "%appearance%" #2
    END
END

DEFINE_PATCH_FUNCTION ALTER_EFF_FILE
INT_VAR
    opcode         = "-1"
    target         = "-1"
    power          = "-1"
    parameter1     = "-999"
    parameter2     = "-1"
    timing         = "-1"
    duration       = "-1"
    probability1   = "-1"
    probability2   = "-1"
    dicenumber     = "-1"
    dicesize       = "-1"
    savingthrow    = "-1"
    savebonus      = "-999"
    special        = "-1"
    primary_type   = "-1"
    min_level      = "-1"
    max_level      = "-1"
    resist_dispel  = "-1"
    parameter3     = "-1"
    parameter4     = "-1"
    parameter5     = "-1"
    secondary_type = "-1"
STR_VAR
    resource = ~none~
BEGIN
    PATCH_IF zs_debug BEGIN
        LPF CHECK_EXTENSION STR_VAR extension = "EFF" END
    END

    PATCH_IF opcode > "-1" BEGIN
        WRITE_LONG 0x10 opcode
    END ELSE PATCH_IF opcode < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to opcode"
    END

    PATCH_IF target > "-1" BEGIN
        WRITE_LONG 0x14 target
    END ELSE PATCH_IF target < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to target"
    END

    PATCH_IF power > "-1" BEGIN
        WRITE_LONG 0x18 power
    END ELSE PATCH_IF power < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to power"
    END

    PATCH_IF parameter1 > "-999" BEGIN
        WRITE_LONG 0x1c parameter1
    END ELSE PATCH_IF parameter1 < "-999" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-999) to parameter1"
    END

    PATCH_IF parameter2 > "-1" BEGIN
        WRITE_LONG 0x20 parameter2
    END ELSE PATCH_IF parameter2 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to parameter2"
    END

    PATCH_IF timing > "-1" BEGIN
        WRITE_LONG 0x24 timing
    END ELSE PATCH_IF timing < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-1) to timing"
    END

    PATCH_IF duration > "-1" BEGIN
        WRITE_LONG 0x27 duration
    END ELSE PATCH_IF duration < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-1) to duration"
    END

    PATCH_IF probability1 > "-1" BEGIN
        WRITE_SHORT 0x2c probability1
    END ELSE PATCH_IF probability1 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to probability1"
    END

    PATCH_IF probability2 > "-1" BEGIN
        WRITE_SHORT 0x2e probability2
    END ELSE PATCH_IF probability2 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to probability2"
    END

    PATCH_IF NOT "%resource%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x30 "%resource%" #8
    END

    PATCH_IF dicenumber > "-1" BEGIN
        WRITE_LONG 0x38 dicenumber
    END ELSE PATCH_IF dicenumber < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to dicenumber"
    END

    PATCH_IF dicesize > "-1" BEGIN
        WRITE_LONG 0x3c dicesize
    END ELSE PATCH_IF dicesize < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to dicesize"
    END

    PATCH_IF savingthrow > "-1" BEGIN
        WRITE_LONG 0x40 savingthrow
    END ELSE PATCH_IF savingthrow < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to savingthrow"
    END

    PATCH_IF savebonus > "-999" BEGIN
        WRITE_LONG 0x44 savebonus
    END ELSE PATCH_IF savebonus < "-999" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-999) to savebonus"
    END

    PATCH_IF primary_type > "-1" BEGIN
        WRITE_LONG 0x4c primary_type
    END ELSE PATCH_IF primary_type < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-1) to primary_type"
    END

    PATCH_IF secondary_type > "-1" BEGIN
        WRITE_LONG 0xd0 secondary_type
    END ELSE PATCH_IF secondary_type < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-1) to secondary_type"
    END

    PATCH_IF resist_dispel > "-1" BEGIN
        WRITE_LONG 0x5c resist_dispel
    END ELSE PATCH_IF resist_dispel < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-1) to resist_dispel"
    END

    PATCH_IF parameter3 > "-1" BEGIN
        WRITE_LONG 0x60 parameter3
    END ELSE PATCH_IF parameter3 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to parameter3"
    END

    PATCH_IF parameter4 > "-1" BEGIN
        WRITE_LONG 0x64 parameter4
    END ELSE PATCH_IF parameter4 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to parameter4"
    END

    PATCH_IF parameter5 > "-1" BEGIN
        WRITE_LONG 0x68 parameter5
    END ELSE PATCH_IF parameter5 < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to parameter5"
    END

    PATCH_IF dicesize > "-1" BEGIN
        WRITE_LONG 0x3c dicesize
    END ELSE PATCH_IF dicesize < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to dicesize"
    END

    PATCH_IF dicenumber > "-1" BEGIN
        WRITE_LONG 0x38 dicenumber
    END ELSE PATCH_IF dicenumber < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to dicenumber"
    END

    PATCH_IF special > "-1" BEGIN
        WRITE_LONG 0x48 special
    END ELSE PATCH_IF special < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to special"
    END
END

DEFINE_PATCH_FUNCTION ALTER_SPELL
INT_VAR
    name = "-2"
    desc = "-2"

    flags      = "-1"
    flags_plus = 0

    spell_type = "-1"

    excl_flags      = "-1"
    excl_flags_plus = 0

    animation = "-1"

    primary_type   = "-1"
    secondary_type = "-1"

    spell_level = "-1"
STR_VAR
    casting_sound = ~none~
    icon          = ~none~
BEGIN
    PATCH_IF zs_debug BEGIN
        LPF CHECK_EXTENSION STR_VAR extension = "SPL" END
    END

    PATCH_IF name > "-2" BEGIN
        WRITE_LONG 0x08 name
    END ELSE PATCH_IF name < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to name"
    END

    PATCH_IF desc > "-2" BEGIN
        WRITE_LONG 0x50 desc
    END ELSE PATCH_IF desc < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to desc"
    END

    PATCH_IF flags > "-1" BEGIN
        WRITE_LONG 0x18 flags
    END ELSE PATCH_IF flags < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to flags"
    END

    PATCH_IF flags_plus > 0 BEGIN
        WRITE_LONG 0x18 (THIS + flags_plus)
    END

    PATCH_IF spell_type > "-1" BEGIN
        WRITE_LONG 0x1c spell_type
    END ELSE PATCH_IF spell_type < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to spell_type"
    END

    PATCH_IF excl_flags > "-1" BEGIN
        WRITE_LONG 0x1e excl_flags
    END ELSE PATCH_IF flags < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to excl_flags"
    END

    PATCH_IF excl_flags_plus > 0 BEGIN
        WRITE_LONG 0x1e (THIS + excl_flags_plus)
    END

    PATCH_IF animation > "-1" BEGIN
        WRITE_LONG 0x22 animation
    END ELSE PATCH_IF spell_type < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to animation"
    END

    PATCH_IF primary_type > "-1" BEGIN
        WRITE_LONG 0x25 primary_type
    END ELSE PATCH_IF primary_type < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to primary_type"
    END

    PATCH_IF secondary_type > "-1" BEGIN
        WRITE_LONG 0x27 secondary_type
    END ELSE PATCH_IF secondary_type < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to secondary_type"
    END

    PATCH_IF spell_level > "-1" BEGIN
        WRITE_LONG 0x34 spell_level
    END ELSE PATCH_IF spell_level < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to spell_level"
    END

    PATCH_IF NOT "%icon%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x3a "%icon%" #8
    END

    PATCH_IF NOT "%casting_sound%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x10 "%casting_sound%" #8
    END
END

DEFINE_PATCH_FUNCTION ALTER_CRE
INT_VAR
    name                = "-2"
    tooltip             = "-2"
    name_tooltip        = "-2"
    //////
    flags               = "-1"
    animation           = "-1"
    status              = "-1"
    //////
    ac_natural          = "-999"
    ac_natural_plus     = 0

    /////
    ac_effective        = "-999"
    ac_effective_plus   = 0
    /////

    ac                  = "-9999"
    ac_plus             = "-9999"

    //////

    ac_crushing         = "-999"
    ac_missile          = "-999"
    ac_piercing         = "-999"
    ac_slashing         = "-999"

    //////

    current_health      = "-1"
    current_health_plus = 0

    /////
    max_health          = "-1"
    max_health_plus     = 0

    //////
    health              = "-1"
    health_plus         = 0

    /////
    thac0               = "-129"
    thac0_plus          = 0
    /////

    fire_resist        = "-129"
    cold_resist        = "-129"
    electricity_resist = "-129"
    acid_resist        = "-129"
    magic_resist       = "-129"
    magic_fire_resist  = "-129"
    magic_cold_resist  = "-129"
    slashing_resist    = "-129"
    crushing_resist    = "-129"
    piercing_resist    = "-129"
    missile_resist     = "-129"

    /////
    class               = "-1"
    alignment           = "-1"
    race                = "-1"
    class               = "-1"
    general             = "-1"

    /////
    save_vs_death       = "-999"
    save_vs_rod         = "-999"
    save_vs_poly        = "-999"
    save_vs_breath      = "-999"
    save_vs_spell       = "-999"

    save_vs_death_plus  = 0
    save_vs_rod_plus    = 0
    save_vs_poly_plus   = 0
    save_vs_breath_plus = 0
    save_vs_spell_plus  = 0

    save_vs_all_plus    = 0
    //////

    level_1             = "-1"
    level_2             = "-1"
    level_3             = "-1"
    /////

    strength            = "-1"
    strength_ex         = "-1"

    strength_plus       = "-1"
    strength_ex_plus    = "-1"

    dexterity = "-1"
    dexterity_plus = "-1"

    constitution = "-1"
    constitution_plus = "-1"

    intelligence = "-1"
    intelligence_plus = "-1"

    wisdom = "-1"
    wisdom_plus = "-1"

    charisma = "-1"
    charisma_plus = "-1"

STR_VAR
    dialog = ~none~
BEGIN
    PATCH_IF zs_debug BEGIN
        LPF CHECK_EXTENSION STR_VAR extension = "CRE" END
    END

    PATCH_IF name_tooltip > "-2" BEGIN

        WRITE_LONG 0x08 name_tooltip
        WRITE_LONG 0x0c name_tooltip

    END ELSE PATCH_IF name_tooltip < "-2" BEGIN

        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to name_tooltip"

    END ELSE BEGIN

        PATCH_IF name > "-2" BEGIN
            WRITE_LONG 0x08 name
        END ELSE PATCH_IF name < "-2" BEGIN
            PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to name"
        END

        PATCH_IF tooltip > "-2" BEGIN
            WRITE_LONG 0x0c tooltip
        END ELSE PATCH_IF tooltip < "-2" BEGIN
            PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to tooltip"
        END

    END

    PATCH_IF flags > "-1" BEGIN
        WRITE_LONG 0x10 flags
    END ELSE PATCH_IF flags < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to flags"
    END

    PATCH_IF animation > "-1" BEGIN
        WRITE_SHORT 0x28 animation
    END ELSE PATCH_IF animation < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to animation"
    END

    PATCH_IF status > "-1" BEGIN
        WRITE_LONG 0x20 status
    END ELSE PATCH_IF status < "-2" BEGIN
        PATCH_FAIL "[FAIL]: Passed a negative value under the default (-2) to status"
    END

    PATCH_IF ac_natural != "-999" BEGIN
        WRITE_SHORT 0x46 ac_natural
    END

    PATCH_IF ac_natural_plus != 0 BEGIN
        WRITE_SHORT 0x46 (THIS + ac_natural_plus)
    END

    PATCH_IF ac_effective != "-999" BEGIN
        WRITE_SHORT 0x48 ac_effective
    END

    PATCH_IF ac_effective_plus != 0 BEGIN
        WRITE_SHORT 0x48 (THIS + ac_effective_plus)
    END

    PATCH_IF ac != "-999" BEGIN
        WRITE_SHORT 0x46 ac
        WRITE_SHORT 0x48 ac
    END

    PATCH_IF ac_plus != 0 BEGIN
        WRITE_SHORT 0x46 (THIS + ac_plus)
        WRITE_SHORT 0x48 (THIS + ac_plus)
    END

    PATCH_IF ac_crushing != "-999" BEGIN
        WRITE_SHORT 0x4a ac_crushing
    END

    PATCH_IF ac_missile != "-999" BEGIN
        WRITE_SHORT 0x4c ac_missile
    END

    PATCH_IF ac_piercing != "-999" BEGIN
        WRITE_SHORT 0x4e ac_piercing
    END

    PATCH_IF ac_slashing != "-999" BEGIN
        WRITE_SHORT 0x50 ac_crushing
    END

    PATCH_IF current_health > "-1" BEGIN
        WRITE_SHORT 0x24 current_health
    END ELSE PATCH_IF current_health < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to current_health"
    END

    PATCH_IF current_health_plus != 0 BEGIN
        WRITE_SHORT 0x24 (THIS + current_health_plus)
    END

    PATCH_IF max_health > "-1" BEGIN
        WRITE_SHORT 0x26 max_health
    END ELSE PATCH_IF max_health < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to max_health"
    END

    PATCH_IF max_health_plus != 0 BEGIN
        WRITE_SHORT 0x26 (THIS + max_health_plus)
    END

    PATCH_IF health > "-1" BEGIN
        WRITE_SHORT 0x24 health
        WRITE_SHORT 0x26 health
    END ELSE PATCH_IF health < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed a non-default (-1) negative value to health"
    END

    PATCH_IF health_plus != 0 BEGIN
        WRITE_SHORT 0x24 (THIS + health_plus)
        WRITE_SHORT 0x26 (THIS + health_plus)
    END

    PATCH_IF thac0 >= "-128" AND thac0 <= 127 BEGIN
        WRITE_BYTE 0x52 thac0
    END ELSE BEGIN
        PATCH_IF thac0 != "-129" BEGIN
            PATCH_FAIL "[FAIL]: Passed an out-of-bounds value to thac0 (valid values are between -128 to 127)"
        END
    END

    PATCH_IF thac0_plus != 0 BEGIN
        WRITE_BYTE 0x52 (THIS + thac0_plus)
    END

    PATCH_IF fire_resist != "-129" BEGIN
        WRITE_BYTE 0x59 fire_resist
    END

    PATCH_IF cold_resist != "-129" BEGIN
        WRITE_BYTE 0x5a cold_resist
    END

    PATCH_IF electricity_resist != "-129" BEGIN
        WRITE_BYTE 0x5b electricity_resist
    END

    PATCH_IF acid_resist != "-129" BEGIN
        WRITE_BYTE 0x5c acid_resist
    END

    PATCH_IF magic_resist != "-129" BEGIN
        WRITE_BYTE 0x5d magic_resist
    END

    PATCH_IF magic_fire_resist != "-129" BEGIN
        WRITE_BYTE 0x5e magic_fire_resist
    END

    PATCH_IF magic_cold_resist != "-129" BEGIN
        WRITE_BYTE 0x5f magic_cold_resist
    END

    PATCH_IF slashing_resist != "-129" BEGIN
        WRITE_BYTE 0x60 slashing_resist
    END

    PATCH_IF crushing_resist != "-129" BEGIN
        WRITE_BYTE 0x61 crushing_resist
    END

    PATCH_IF piercing_resist != "-129" BEGIN
        WRITE_BYTE 0x62 piercing_resist
    END

    PATCH_IF missile_resist != "-129" BEGIN
        WRITE_BYTE 0x63 missile_resist
    END

    PATCH_IF alignment > "-1" AND alignment <= 255 BEGIN
        WRITE_BYTE 0x27b alignment
    END ELSE PATCH_IF alignment < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed an out-of-bounds value to alignment (valid values are between 0 to 255)"
    END

    PATCH_IF general > "-1" AND general <= 255 BEGIN
        WRITE_BYTE 0x271 general
    END ELSE PATCH_IF general < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed an out-of-bounds value to general (valid values are between 0 to 255)"
    END

    PATCH_IF race > "-1" AND race <= 255 BEGIN
        WRITE_BYTE 0x272 race
    END ELSE PATCH_IF race < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed an out-of-bounds value to race (valid values are between 0 to 255)"
    END

    PATCH_IF class > "-1" AND class <= 255 BEGIN
        WRITE_BYTE 0x273 class
    END ELSE PATCH_IF class < "-1" BEGIN
        PATCH_FAIL "[FAIL]: Passed an out-of-bounds value to class (valid values are between 0 to 255)"
    END

    PATCH_IF save_vs_death != "-999" BEGIN
        WRITE_BYTE 0x54 save_vs_death
    END

    PATCH_IF save_vs_death_plus != 0 BEGIN
        WRITE_BYTE 0x54 (THIS + save_vs_death_plus)
    END

    PATCH_IF save_vs_rod != "-999" BEGIN
        WRITE_BYTE 0x55 save_vs_rod
    END

    PATCH_IF save_vs_rod_plus != 0 BEGIN
        WRITE_BYTE 0x55 (THIS + save_vs_rod_plus)
    END

    PATCH_IF save_vs_poly != "-999" BEGIN
        WRITE_BYTE 0x56 save_vs_poly
    END

    PATCH_IF save_vs_poly_plus != 0 BEGIN
        WRITE_BYTE 0x56 (THIS + save_vs_poly_plus)
    END

    PATCH_IF save_vs_spell != "-999" BEGIN
        WRITE_BYTE 0x57 save_vs_spell
    END

    PATCH_IF save_vs_spell_plus != 0 BEGIN
        WRITE_BYTE 0x58 (THIS + save_vs_spell_plus)
    END

    PATCH_IF save_vs_all_plus != 0 BEGIN
        WRITE_BYTE 0x54 (THIS + save_vs_all_plus)
        WRITE_BYTE 0x55 (THIS + save_vs_all_plus)
        WRITE_BYTE 0x56 (THIS + save_vs_all_plus)
        WRITE_BYTE 0x57 (THIS + save_vs_all_plus)
        WRITE_BYTE 0x58 (THIS + save_vs_all_plus)
    END

    PATCH_IF level_1 > "-1" AND level1 <= 255 BEGIN
        WRITE_BYTE 0x234 level_1
    END

    PATCH_IF level_2 > "-1" AND level2 <= 255 BEGIN
        WRITE_BYTE 0x235 level_2
    END

    PATCH_IF level_3 > "-1" AND level3 <= 255 BEGIN
        WRITE_BYTE 0x236 level_3
    END

    PATCH_IF NOT "%dialog%" STR_EQ "none" BEGIN
        WRITE_ASCII 0x2cc "%dialog%" #8
    END
END

DEFINE_PATCH_FUNCTION ALTER_PROJECTILE
INT_VAR
    trap_size      = "-1"
    explosion_size = "-1"
BEGIN
    PATCH_IF zs_debug BEGIN
        LPF CHECK_EXTENSION STR_VAR extension = "PRO" END
    END

    READ_SHORT 0x8 projectile_type
    PATCH_IF trap_size > "-1" BEGIN
        PATCH_IF projectile_type = 3 BEGIN
            WRITE_SHORT 0x204 trap_size
        END ELSE BEGIN
            PATCH_FAIL "[FAIL]: Trap size can only be modified if the projectile is an Area of Effect"
        END
    END

    PATCH_IF explosion_size > "-1" BEGIN
        PATCH_IF projectile_type = 3 BEGIN
            WRITE_SHORT 0x206 explosion_size
        END ELSE BEGIN
            PATCH_FAIL "[FAIL]: Explosion size can only be modified if the projectile is an Area of Effect"
        END
    END
END

